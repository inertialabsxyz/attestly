target/
data/*
!data/.gitkeep
attestations.json
executions.json

# awp-cloud local dev outputs
services/awp-cloud/data/

# Runtime outputs (identity secrets, attestation logs) produced inside a
# Python package directory when an example is run from there.
python/**/data/
python/**/dist/
python/**/*.egg-info/

# Python tooling
.venv/
__pycache__/
*.pyc
.pytest_cache/
crates/awp-python/dist/
crates/awp-python/*.egg-info/
# PyO3 extension built in place by `maturin develop`
crates/awp-python/python/awp/_native.*.so
crates/awp-python/python/awp/_native.*.pyd
crates/awp-python/python/awp/_native.*.dylib
