target/
data/*
!data/.gitkeep
attestations.json
executions.json

# attestly-cloud local dev outputs
services/attestly-cloud/data/

# Runtime outputs (identity secrets, attestation logs) produced inside a
# Python package directory when an example is run from there.
python/**/data/
python/**/dist/
python/**/*.egg-info/

# Python tooling
.venv/
__pycache__/
*.pyc
.pytest_cache/
crates/attestly-python/dist/
crates/attestly-python/*.egg-info/
# PyO3 extension built in place by `maturin develop`
crates/attestly-python/python/attestly/_native.*.so
crates/attestly-python/python/attestly/_native.*.pyd
crates/attestly-python/python/attestly/_native.*.dylib
